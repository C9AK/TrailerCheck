DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/trailercheck
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# R52: optional recovery credentials for the `admin`-role account — lets its
# owner log in even if the primary password is somehow changed or lost.
# Leave both unset to disable backup-password login entirely. NEVER commit
# real values here — this file is tracked; only backend/.env (gitignored)
# or the hosting platform's own environment variable UI should ever hold
# the actual passwords.
ADMIN_BACKUP_PASSWORD_1=
ADMIN_BACKUP_PASSWORD_2=
